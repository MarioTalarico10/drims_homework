<?xml version="1.0"?>

<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>dice_interfaces</name>

  <version>0.0.1</version>

  <description>
    Custom ROS 2 interfaces for the OAK-based dice detector.
  </description>

  <maintainer email="mario.talarico@example.com">
    Mario Talarico
  </maintainer>

  <license>MIT</license>

  <!-- ==========================================================
       BUILD SYSTEM
       ========================================================== -->

  <buildtool_depend>
    ament_cmake
  </buildtool_depend>

  <!-- ==========================================================
       INTERFACE GENERATION
       ========================================================== -->

  <buildtool_depend>
    rosidl_default_generators
  </buildtool_depend>

  <!-- ==========================================================
       MESSAGE DEPENDENCIES USED BY DetectDice.srv
       ========================================================== -->

  <depend>
    sensor_msgs
  </depend>

  <depend>
    geometry_msgs
  </depend>

  <!-- ==========================================================
       RUNTIME SUPPORT FOR GENERATED INTERFACES
       ========================================================== -->

  <exec_depend>
    rosidl_default_runtime
  </exec_depend>

  <!-- Required for packages that define ROS interfaces -->

  <member_of_group>
    rosidl_interface_packages
  </member_of_group>

  <export>

    <build_type>
      ament_cmake
    </build_type>

  </export>

</package>